<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.iot.mapper.IotSubDeviceMapper">

    <!--  查询所有子设备  -->
    <select id="selectAllSubDevices" resultType="com.management.iot.domain.IotSubDevice">
        SELECT * FROM iot_sub_device ORDER BY record_time DESC
    </select>

    <!--  根据设备id查询子设备  -->
    <select id="selectSubDeviceById" resultType="com.management.iot.domain.IotSubDevice"
            parameterType="java.lang.Long">
        SELECT * FROM iot_sub_device WHERE device_id = #{deviceId} ORDER BY create_time DESC
    </select>

    <!--  根据设备编码查询子设备  -->
    <select id="selectSubDeviceByCode" resultType="com.management.iot.domain.IotDevice"
            parameterType="java.lang.String">
        SELECT * FROM iot_sub_device WHERE sub_code = #{subCode}
    </select>

    <!--  查询所有设备主机  -->
    <select id="findDistinctHosts" resultType="java.lang.String">
        SELECT DISTINCT host FROM iot_sub_device
    </select>

    <!--  根据主机查询设备  -->
    <select id="findByHost" resultType="com.management.iot.domain.IotSubDevice"
            parameterType="java.lang.String">
        SELECT * FROM iot_sub_device WHERE host = #{host}
    </select>

    <!--  获取设备最新的数据  -->
<!--    <select id="selectLatestTelemetryByDeviceId" resultType="com.management.iot.domain.IotTelemetry"-->
<!--            parameterType="java.lang.Long">-->
<!--        SELECT t1.* FROM jy_management.iot_telemetry t1 " +-->
<!--            "INNER JOIN (SELECT data_key, MAX(record_time) as max_time FROM iot_telemetry WHERE device_id = #{deviceId} GROUP BY data_key) t2 " +-->
<!--            "ON t1.data_key = t2.data_key AND t1.record_time = t2.max_time " +-->
<!--            "WHERE t1.device_id = #{deviceId}-->
<!--    </select>-->

    <!--  添加子设备数据  -->
    <insert id="insertSubDevice" parameterType="com.management.iot.domain.IotSubDevice">
        INSERT INTO iot_sub_device
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="subId != null">sub_id,</if>
            <if test="subName != null">sub_name,</if>
            <if test="subCode != null">sub_code,</if>
            <if test="subType != null">sub_type,</if>
            <if test="status != null">status,</if>
            <if test="deviceId != null">device_id,</if>
            <if test="host != null">host,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="subId != null">#{subId},</if>
            <if test="subName != null">#{subName},</if>
            <if test="subCode != null">#{subCode},</if>
            <if test="subType != null">#{subType},</if>
            <if test="status != null">#{status},</if>
            <if test="deviceId != null">#{deviceId},</if>
            <if test="host != null">#{host},</if>
            <if test="remark != null">#{remark},</if>
            CURRENT_TIMESTAMP
        </trim>
    </insert>

    <update id="updateStatusByHost">
        UPDATE iot_sub_device SET status = #{status} WHERE host = #{host}
    </update>

    <!--  批量插入时序数据记录  -->
    <insert id="batchInsertTelemetry"
            parameterType="java.util.List">
        INSERT INTO iot_telemetry (telemetry_id, device_id, data_key, data_value, unit, record_time)
        VALUES
        <foreach collection="telemetryList" item="item" separator=",">
            (#{item.telemetryId},#{item.deviceId}, #{item.dataKey}, #{item.dataValue}, #{item.unit}, CURRENT_TIMESTAMP)
        </foreach>
    </insert>

    <!--  根据设备ID删除时序数据  -->
    <delete id="deleteTelemetryByDeviceId" parameterType="java.lang.Integer">
        DELETE FROM iot_telemetry WHERE device_id = #{deviceId}
    </delete>
</mapper>