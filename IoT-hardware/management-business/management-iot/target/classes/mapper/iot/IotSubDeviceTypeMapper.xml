<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.iot.mapper.IotSubDeviceTypeMapper">

    <!--  获取子设备类型列表  -->
    <select id="selectAllSubDevicesType" resultType="com.management.iot.domain.IotSubDeviceType">
        select sub_device_type_id,sub_device_parent_id,sub_device_type_name,del_flag,create_time,update_time from iot_sub_device_type
    </select>

    <select id="getSubDeviceTypeInfo" resultType="com.management.iot.domain.IotSubDeviceType" parameterType="long">
        select sub_device_type_id,sub_device_parent_id,sub_device_type_name,del_flag,create_time,update_time from iot_sub_device_type where sub_device_type_id = #{subDeviceTypeId}
    </select>

    <insert id="saveSubDeviceType" parameterType="com.management.iot.domain.IotSubDeviceType">
        INSERT INTO iot_sub_device_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="subDeviceTypeId != null">sub_device_type_id,</if>
            <if test="subDeviceParentId != null">sub_device_parent_id,</if>
            <if test="subDeviceTypeName != null">sub_device_type_name,</if>
            <if test="delFlag != null">del_flag,</if>
            create_time
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="subDeviceTypeId != null">#{subDeviceTypeId},</if>
            <if test="subDeviceParentId != null">#{subDeviceParentId},</if>
            <if test="subDeviceTypeName != null">#{subDeviceTypeName},</if>
            <if test="delFlag != null">#{delFlag},</if>
            CURRENT_TIMESTAMP
        </trim>
    </insert>

    <update id="updateSubDeviceType" parameterType="com.management.iot.domain.IotSubDeviceType">
        UPDATE iot_sub_device_type
        <set>
            <if test="subDeviceParentId != null">sub_device_parentId = #{subDeviceParentId},</if>
            <if test="subDeviceTypeName != null">sub_device_type_name = #{subDeviceTypeName},</if>
            <if test="status != null">status = #{status},</if>
            update_time = CURRENT_TIMESTAMP
        </set>
        WHERE sub_device_type_id = #{subDeviceTypeId}
    </update>
</mapper>