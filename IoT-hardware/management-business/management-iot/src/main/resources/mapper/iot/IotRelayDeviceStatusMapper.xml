<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.iot.mapper.IotRelayDeviceStatusMapper">

    <!--  插入继电器信息  -->
    <insert id="insertRelayDeviceStatus" parameterType="com.management.iot.domain.IotRelayDeviceStatus">
        INSERT INTO iot_relay_device_status
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="relayId != null">relay_id,</if>
            <if test="relayDeviceName != null">relay_device_name,</if>
            <if test="status != null">status,</if>
            <if test="protocolId != null">protocol_id,</if>
            create_time
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="relayId != null">#{relayId},</if>
            <if test="relayDeviceName != null">#{relayDeviceName},</if>
            <if test="status != null">#{status},</if>
            <if test="protocolId != null">#{protocolId},</if>
            CURRENT_TIMESTAMP
        </trim>
    </insert>
    <select id="getRelayDeviceStatusByProtocol" resultType="com.management.iot.domain.IotRelayDeviceStatus"
            parameterType="java.lang.Long">
        SELECT * FROM iot_relay_device_status
        WHERE protocol_id = #{protocolId}
        ORDER BY create_time DESC
        LIMIT 4
    </select>

</mapper>